{
  "name": "estoque",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/estoque",
  "tags": [],
  "targets": {
    "test": {
      "options": {
        "race": true
      }
    },
    "integration": {
      "command": "go test -race -count=1 -tags integration ./internal/inventory/postgres/...",
      "options": {
        "cwd": "apps/estoque"
      },
      "cache": false
    },
    "sqlc": {
      "command": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 generate",
      "options": {
        "cwd": "apps/estoque"
      }
    }
  }
}
