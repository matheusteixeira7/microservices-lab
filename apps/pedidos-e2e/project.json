{
  "name": "pedidos-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "pedidos"
  ],
  "projectType": "application",
  "targets": {
    "e2e": {
      "command": "jest --passWithNoTests",
      "options": {
        "cwd": "apps/pedidos-e2e"
      },
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}"
      ],
      "dependsOn": [
        "pedidos:build",
        "pedidos:serve"
      ]
    }
  }
}
